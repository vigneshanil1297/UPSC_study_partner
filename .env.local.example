# Copy to .env.local and fill in. NEVER commit the real keys.
# Free key (no billing required): https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Supabase — saved evaluation history + Google sign-in.
# Project URL + publishable (anon) key. Run data/supabase-schema.sql once.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Comma-separated Google emails allowed to use the app (server-only).
# Required — if empty, all API requests are denied (fails closed).
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
