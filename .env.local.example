# Copy to .env.local and fill in. NEVER commit the real keys.
# Free key (no billing required): https://aistudio.google.com/apikey
# In local dev you can leave this BLANK to route the AI calls through the
# `claude` CLI (Claude Code) instead — see LLM_PROVIDER below. Production needs it.
GEMINI_API_KEY=AIza...

# Which LLM backend the transcribe/extract/evaluate routes use:
#   gemini  — Gemini free-tier API (needs GEMINI_API_KEY). Used in production.
#   claude  — shell out to the local `claude` CLI (uses your Claude subscription,
#             not Gemini quota). Dev only; the CLI must be on PATH.
# Unset: defaults to "claude" in dev when GEMINI_API_KEY is blank, else "gemini".
# LLM_PROVIDER=claude
# Optional model for the claude backend (default: CLI's configured model).
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Supabase — saved evaluation history + Google sign-in.
# Project URL + publishable (anon) key. Run data/supabase-schema.sql once.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Comma-separated Google emails allowed to use the app (server-only).
# Required — if empty, all API requests are denied (fails closed).
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

# Dev only: set to 1 to skip Google sign-in entirely (no OAuth needed locally).
# Both client and server ignore it in production builds, so it can't unlock the
# deployed app. Leave unset for production.
# NEXT_PUBLIC_DEV_NO_AUTH=1
